<li class="list-group-item d-flex justify-content-between align-items-start">
  <div class="w-100">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <strong><%= comment.user.email %></strong>
      <small class="text-muted"><%= time_ago_in_words(comment.created_at) %> ago</small>
    </div>
    <p class="mb-0"><%= comment.content %></p>
  </div>
  <% if current_user == comment.user %>
    <%= link_to 'Supprimer', event_comment_path(comment.event, comment), method: :delete, data: { confirm: 'Êtes-vous sûr ?' }, class: 'btn btn-sm btn-outline-danger ms-3' %>
  <% end %>
</li>