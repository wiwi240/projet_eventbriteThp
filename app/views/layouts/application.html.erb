<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Eventbrite | Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%# Icônes et Polices %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

    <%# Thème Bootswatch futuriste (Cyborg) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.2.3/cyborg/bootstrap.min.css" integrity="sha384-OHzT3pzlVXlM6xGhGXPkSPq0dpmxG3wliDkIqj+1rx2+bbdW6XisNqJia2+I8j9B" crossorigin="anonymous">

    <%# Un seul fichier CSS pour éviter les erreurs Propshaft en Rails 8 %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# Overrides for futuristic theme %>
    <%= stylesheet_link_tag "overrides", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render 'layouts/header' %>
    <%= render 'layouts/flash' %>

    <%# Contenu principal de chaque page %>
    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <%= render 'layouts/footer' %>
    </footer>
  </body>
</html>